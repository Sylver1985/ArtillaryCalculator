# Server config for Apache/LiteSpeed shared hosting (Hostinger and the like).
# deploy/build-site.sh puts it in the package as .htaccess. It does what
# deploy/nginx.conf does for the Fly.io image, and works whether the site is
# at a domain's root or in a folder.

DirectoryIndex index.html
Options -Indexes
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
    RewriteEngine On

    # dotfiles (a .git folder, if the site is deployed with hPanel's Git) are
    # never served; .well-known stays reachable for SSL certificate checks
    RewriteRule (^|/)\.(?!well-known/) - [F]

    # …/l81/ -> …/l81, so the page's relative links resolve from the folder
    RewriteCond %{REQUEST_URI} ^(.*/(?:l81|sph2|guide))/$
    RewriteRule ^ %1 [R=301,L]

    RewriteCond %{REQUEST_URI} ^(.*/)privacy$
    RewriteRule ^ %1privacy.html [R=301,L]

    RewriteRule ^favicon\.ico$ img/favicon.ico [L]

    # the guide is guide.html, at a clean address (THE_REQUEST: only what the
    # visitor asked for, so the rewrite below doesn't loop back here)
    RewriteCond %{THE_REQUEST} \s(/(?:.*/)?)guide\.html[\s?]
    RewriteRule ^ %1guide [R=301,L]
    RewriteRule ^guide$ guide.html [L]

    # the tool pages are the same file; its script reads the address
    RewriteRule ^(?:l81|sph2)$ index.html [L]
</IfModule>

<IfModule mod_headers.c>
    # Every file here can change with an update and they are all small, so
    # browsers revalidate each visit (a 304 when nothing changed) rather than
    # holding a stale calculator for days.
    Header always set Cache-Control             "no-cache"
    Header always set X-Content-Type-Options    "nosniff"
    Header always set Referrer-Policy           "strict-origin-when-cross-origin"
    Header always set X-Frame-Options           "SAMEORIGIN"
    Header always set Permissions-Policy        "camera=(), microphone=(), geolocation=()"
    Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# the page is ~330 KB, mostly the embedded background photo (LiteSpeed
# compresses on its own; this covers Apache)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript image/svg+xml
</IfModule>
